+                source.update({"type": "lesson", "lesson_id": lesson["id"], "lesson_title": lesson["title"]})
+                deck["source"] = source
+                return deck
+        return None
+
+    def add_lesson_flashcard(self, raw_username: Any, lesson_id: str, payload: dict[str, Any]) -> dict[str, Any]:
